[Unit]
Description=Cloudflare Quick Tunnel for Pollination Monitoring
After=network-online.target pollination-app.service
Wants=network-online.target pollination-app.service
PartOf=pollination-app.service

[Service]
Type=simple
User=root1
Group=root1
WorkingDirectory=/home/root1/Documents/Capstone
Environment=APP_PORT=5000
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:5000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
